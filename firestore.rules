rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each authenticated user has full access strictly to their own data tree
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /{subcollection=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
